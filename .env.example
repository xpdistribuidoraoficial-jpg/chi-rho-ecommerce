# Mercado Pago — preencher somente nos ambientes seguros da Vercel/Supabase.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
# O padrão seguro é true; somente mudar para false após autorização de produção.
MERCADO_PAGO_TEST_MODE=true

# Frenet — token de cotação já existente; o Partner Token é exigido pelo OneClick.
FRENET_TOKEN=
FRENET_SELLER_CEP=
FRENET_PARTNER_TOKEN=
FRENET_PRINTING_FORMAT=A4
